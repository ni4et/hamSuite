    <div><strong>Label 5:</strong> <span id="status5">--</span></div>
    <div><strong>Label 6:</strong> <span id="status6">--</span></div>
  </div>
  <!-- ...existing code... -->

  <!-- ...existing code... -->
  <script>
    const socket = io();
    socket.emit("chat message", "hallo chat message");
    socket.on("status", (content) => {
      console.log(content);
      // Example: content = { label1: "A", label2: "B", ... }
      for (let i = 1; i <= 6; i++) {
        const el = document.getElementById(`status${i}`);
        if (el && content[`label${i}`] !== undefined) {
          el.textContent = content[`label${i}`];
        }
      }
    });
  </script>
